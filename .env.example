# ─────────────────────────────────────────────────────────────────────────
# apps/api — set these on the API's deployment (its own Vercel project, or
# wherever it's self-hosted)
# ─────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/cloudn?sslmode=require"

# Sessions
SESSION_SECRET="change-me-to-a-long-random-string"

# Node credential encryption (AES-256-GCM, 32 bytes as 64 hex chars).
# Generate with: openssl rand -hex 32
# Required in production — the Panel must be able to decrypt a node's
# secret to present it when calling that node's Agent (see
# docs/CLOUDN_AGENT_INTEGRATION.md §2.1). Falls back to a key derived from
# SESSION_SECRET in development if unset; do not rely on that in production.
NODE_CREDENTIAL_ENCRYPTION_KEY=""

# The exact origin(s) the frontend is deployed at — web and API are two
# separate deployments/origins, so this is required for both CORS and for
# the session cookie's SameSite=None behavior to work at all in
# production. Comma-separate multiple origins (e.g. a preview URL
# alongside prod). No trailing slash.
#   WEB_URL="https://cloudn-web.vercel.app,https://cloudn.example.com"
WEB_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Only relevant for the self-hosted single-process deployment path (see
# README "Self-hosted"). Leave unset/false for the primary split-hosting
# (two Vercel projects) path — that path is always cross-origin and needs
# the cross-site cookie policy. Set to "true" only if you're self-hosting
# same-origin WITHOUT HTTPS configured; forcing the cross-site cookie
# policy (Secure) without HTTPS would make the browser silently refuse to
# store the session cookie at all.
SAME_ORIGIN_DEPLOYMENT=false

# Infrastructure
INFRASTRUCTURE_PROVIDER=mock

# Feature flags
ENABLE_REAL_AGENT=false
ENABLE_BILLING=false
ENABLE_DATABASE_PROVISIONING=false

# ─────────────────────────────────────────────────────────────────────────
# apps/web — set on the frontend's deployment (its own Vercel project).
# Vite only exposes env vars prefixed VITE_ to client code.
# ─────────────────────────────────────────────────────────────────────────

# The API's deployed URL. No trailing slash.
#   VITE_API_URL="https://cloudn-api.vercel.app"
VITE_API_URL="http://localhost:4000"
