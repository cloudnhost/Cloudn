# The API's deployed URL. No trailing slash.
# In local dev this defaults to http://localhost:4000 even if unset (see
# src/lib/api.ts) — you only need to set this explicitly for a deployed
# build, e.g. on Vercel:
#   VITE_API_URL="https://cloudn-api.vercel.app"
VITE_API_URL="http://localhost:4000"
